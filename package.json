{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "prepare": "husky",
        "vitest-coverage": "vitest run --coverage",
        "lint-not-functional": "eslint . --ext .js,.vue resources/js/",
        "lint": "eslint resources/js/",
        "lint-fix": "eslint --fix --config eslint.config.js  resources/js/ ",
        "vitest-test": "vitest run",
        "pre-commit": "lint-staged"
    },
    "lint-staged": {
        "**/*.php": "./vendor/bin/pint --config pint.json --preset laravel",
        "**/*.js": "eslint --fix --config eslint.config.js",
        "**/*.vue": "eslint --fix --config eslint.config.js"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^5.0.0",
        "autoprefixer": "^10.4.12",
        "axios": "^1.8.2",
        "concurrently": "^9.0.1",
        "eslint": "^9.29.0",
        "eslint-plugin-vue": "^9.27.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^1.2.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.2.1",
        "vite": "^6.2.4",
        "vue": "^3.4.0"
    }
}
